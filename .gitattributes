# ---------------------------------------------------------------------------
# .gitattributes —— 让「行尾符」由仓库统一决定，而不是靠每个人自己配
# ---------------------------------------------------------------------------
# 为什么需要这个文件？
# docs/01-环境安装.md 让每个人设了 core.autocrlf=true，
# 但现实中总有人没设、或者用 Git GUI 绕过了设置。
# 一旦有人提交了 CRLF 文件，整个团队就再也看不懂 git diff 了。
#
# 这个文件把规则【固化进仓库】——不管你本地怎么配，行为都一致。
# 这是「团队协作」和「个人用 Git」的关键区别。
#
# 详见 docs/01-环境安装.md 第 3.4 节。
# ---------------------------------------------------------------------------

# 默认：自动识别文本文件，提交时统一转成 LF 存进仓库
* text=auto eol=lf

# --- 明确指定为文本的文件（规范化为 LF）---
*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.sh    text eol=lf
*.xml   text eol=lf

# --- Windows 专用脚本必须保留 CRLF，否则 .bat/.ps1 会执行失败 ---
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ★ .ps1 必须【同时满足】两个条件，否则脚本在 Windows PowerShell 5.1 下会报
#   一堆莫名其妙的语法错误（Unexpected token '}' / Missing closing '}'）：
#     1. 行尾符是 CRLF
#     2. 文件保存为 UTF-8 **with BOM**
#   原因：Windows PowerShell 5.1（桌面版，系统自带那个）在没有 BOM 时
#   会按系统 ANSI 代码页（中文 Windows 是 GBK/cp936）解码 .ps1 文件，
#   于是脚本里的中文变成乱码，乱码字节又会破坏字符串引号配对，
#   最终报出与真实原因完全无关的语法错误。
#   PowerShell 7+ 默认按 UTF-8 读取，不受影响 —— 但队员们用的是系统自带的 5.1。
#
#   ⚠️ 修改 .ps1 后请务必确认 BOM 还在：
#      $b=[IO.File]::ReadAllBytes('x.ps1')[0..2]; $b -join ','
#      期望输出 239,187,191
#   修复方法（在 PowerShell 里）：
#      $p='x.ps1'; $t=Get-Content $p -Raw -Encoding UTF8
#      [IO.File]::WriteAllText($p,$t,(New-Object Text.UTF8Encoding($true)))
#
#   注意：`text eol=crlf` 本身不会破坏 BOM（已验证），
#   但很多编辑器「另存为 UTF-8」会默认去掉 BOM，那才是真正的风险点。
*.ps1   text eol=crlf

# --- 二进制文件：禁止 Git 做任何换行/编码转换 ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.pt    binary
*.pth   binary
*.ckpt  binary
*.pkl   binary
*.npy   binary
*.npz   binary
*.mjb   binary
*.stl   binary
*.obj   binary
*.dae   binary

# --- 语言与统计 ---
# 让 GitHub 不要把 HTML 目录当成「文档」语言，影响语言统计
tools/walkviz/index.html linguist-vendored=false

# git diff 时对 Jupyter notebook 更友好（后期训练可视化会用到）
*.ipynb diff=jupyternotebook
